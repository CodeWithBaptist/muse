# PostgreSQL connection string (for example, your pooled Neon connection URL)
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Spotify Developer application Client ID from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id

# Spotify Developer application Client Secret
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Spotify OAuth callback URL (use http://127.0.0.1:3000/api/auth/spotify/callback for local development)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# Which provider to use: "anthropic" or "gemini". Leave unset to auto-detect
# from whichever key below is configured (Anthropic wins if both are set).
AI_PROVIDER=

# --- Option A: Anthropic Claude (paid: ~$2/$10 per 1M tokens on Sonnet) ---
# API key from https://platform.claude.com/settings/keys
# NOTE: a Claude Pro/Max subscription does NOT include API credits.
ANTHROPIC_API_KEY=add-later

# Optional Claude model override (defaults to claude-sonnet-5-5; claude-haiku-4-5 is cheaper and faster)
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Option B: Google AI Studio (free tier, no credit card) ---
# API key from https://aistudio.google.com/apikey
# Free tier is rate limited and Google may use free-tier data to improve its models,
# so use this for development. See the privacy notes in README.md.
GEMINI_API_KEY=

# Optional Gemini model override (defaults to gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest

# 32-character secret key used to encrypt Spotify OAuth tokens at rest
# Generate one with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=replace_with_32_character_hex_key
