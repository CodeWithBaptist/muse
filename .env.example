# PostgreSQL connection string.
# Local development: this matches the database in docker-compose.yml (npm run db:up).
# Hosted database (for example a pooled Neon URL) instead:
#   postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://muse:muse@127.0.0.1:5432/muse

# Spotify Developer application Client ID from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id

# Spotify Developer application Client Secret
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Spotify OAuth callback URL (use http://127.0.0.1:3000/api/auth/spotify/callback for local development)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# OpenAI API key for chat, recommendations, discover, and profile insights (use add-later until ready)
OPENAI_API_KEY=add-later

# 32-character secret key used to encrypt Spotify OAuth tokens at rest
# Generate one with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=replace_with_32_character_hex_key

# Optional: Upstash Redis (REST) for rate limiting and the daily AI budget.
# Create a database at https://console.upstash.com and copy both values.
# Leave both unset to use the Postgres rate_limits table instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
