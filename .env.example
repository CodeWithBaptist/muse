# PostgreSQL connection string (for example, your pooled Neon connection URL)
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Spotify Developer application Client ID from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id

# Spotify Developer application Client Secret
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Spotify OAuth callback URL (use http://127.0.0.1:3000/api/auth/spotify/callback for local development)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# Anthropic API key for Claude chat, recommendations, discover, and profile insights (use add-later until ready)
ANTHROPIC_API_KEY=add-later

# Optional Claude model override (defaults to claude-sonnet-5-5; claude-haiku-4-5 is a cheaper, faster option)
ANTHROPIC_MODEL=claude-sonnet-5-5

# 32-character secret key used to encrypt Spotify OAuth tokens at rest
# Generate one with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=replace_with_32_character_hex_key
